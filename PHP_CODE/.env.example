APP_NAME="Zolo Smart School"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://zoloschools.com
DEMO_MODE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# Keep this at warning or above in production. Payment callbacks and password
# reset requests are logged, and debug level writes far more than you want kept.
LOG_LEVEL=warning

# The application account needs CREATE and DROP DATABASE, because each school is
# provisioned into its own schema. Grant that against a prefix rather than
# globally, e.g.  GRANT ALL ON `zolo\_schools\_%`.* TO 'zolo'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zolo_schools
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# School provisioning runs on the queue and takes as long as the tenant migration
# set takes, so a worker must be running:  php artisan queue:work --timeout=3600
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Leave unset to follow APP_ENV, or force it on when TLS terminates upstream.
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

LOGO1=
LOGO2=
FAVICON=
timezone=Asia/Kolkata
APPLANG=en

# Comma separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=https://zoloschools.com

# Seconds allowed for provisioning one school's database. Benchmark the tenant
# migration set on your own hardware first; the queue worker's --timeout must be
# at least this large.
SCHOOL_SETUP_TIMEOUT=3600

# Set these to pin the first administrator during an automated deployment.
# Left empty, the installer generates a password and prints it once.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_URL=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_URL=

PAYSTACK_SECRET_KEY=

RECAPTCHA_SITE=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Shared secret for scheduler-driven endpoints such as /api/fees-due-notification.
# Generate one with: php artisan tinker --execute="echo Str::random(48);"
# Without it those endpoints return 404.
CRON_SECRET=
